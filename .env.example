# Option A: use a named connection from ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION_NAME=

# Option B: explicit credentials
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair auth (recommended)
SNOWFLAKE_PRIVATE_KEY_PATH=
# or password auth
SNOWFLAKE_PASSWORD=

# Optional: programmatic access token for the Analyst / Agent REST calls
SNOWFLAKE_PAT=

SNOWFLAKE_ROLE=CORTEX_DEV_ROLE
SNOWFLAKE_WAREHOUSE=CORTEX_WH
SNOWFLAKE_DATABASE=SNOWCORTEX
SNOWFLAKE_SCHEMA=SUPPORT

CORTEX_SEARCH_SERVICE=KB_SEARCH
CORTEX_SEMANTIC_STAGE=SEMANTIC_MODELS
CORTEX_SEMANTIC_FILE=support_tickets.yaml
CORTEX_LLM_MODEL=mistral-large2
CORTEX_AGENT_MODEL=auto
